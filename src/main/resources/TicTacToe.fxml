<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!--
  Tic-Tac-Toe board screen.
  The 3x3 buttons are created by the controller and added to fx:id="grid".
  All game rules live in games.tictactoe.Board - this screen is just the view.
  Style freely; keep fx:id="grid" and fx:id="lblStatus".
-->
<VBox alignment="CENTER" prefHeight="500.0" prefWidth="1000.0" spacing="20.0"
      stylesheets="@style.css"
      xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.tictactoe2.TicTacToeController">
    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0"/>
    </padding>
    <children>
        <Label text="Tic-Tac-Toe"/>
        <GridPane fx:id="grid" alignment="CENTER" hgap="5.0" vgap="5.0"/>
        <Label fx:id="lblStatus" text="Player X's turn"/>
        <HBox alignment="CENTER" spacing="15.0">
            <children>
                <Button onAction="#onBack" prefHeight="40.0" prefWidth="120.0" text="Back"/>
                <Button onAction="#onReset" prefHeight="40.0" prefWidth="120.0" text="New game"/>
            </children>
        </HBox>
    </children>
</VBox>
