<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.tictactoe2.ScoreBoardController"
            prefHeight="650.0"
            prefWidth="1000.0">

    <children>

        <VBox spacing="20.0"
              AnchorPane.topAnchor="20.0"
              AnchorPane.bottomAnchor="20.0"
              AnchorPane.leftAnchor="25.0"
              AnchorPane.rightAnchor="25.0">

            <children>

                <HBox alignment="CENTER_LEFT" spacing="15.0">

                    <children>

                        <Label text="SCORES &amp; HIGHSCORES"
                               style="-fx-font-size: 26px; -fx-font-weight: bold;"/>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Button text="Refresh"
                                onAction="#refreshData"/>

                        <Button text="Return"
                                onAction="#goReturn"/>

                        <Button text="Back"
                                onAction="#goBack"/>

                    </children>

                </HBox>

                <!-- main part of screen -->
                <HBox spacing="20.0" VBox.vgrow="ALWAYS">

                    <children>

                        <!-- table with results -->
                        <VBox spacing="10.0"
                              HBox.hgrow="ALWAYS">

                            <children>

                                <Label text="Game Scores"
                                       style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

                                <TableView fx:id="scoresTable"
                                           VBox.vgrow="ALWAYS">

                                    <columns>

                                        <TableColumn fx:id="usernameColumn"
                                                     text="Player"
                                                     prefWidth="120.0"/>

                                        <TableColumn fx:id="gameColumn"
                                                     text="Game"
                                                     prefWidth="115.0"/>

                                        <TableColumn fx:id="gameModeColumn"
                                                     text="Game Mode"
                                                     prefWidth="140.0"/>

                                        <TableColumn fx:id="resultColumn"
                                                     text="Result"
                                                     prefWidth="114.0"/>

                                        <TableColumn fx:id="dateColumn"
                                                     text="Date"
                                                     prefWidth="145.0"/>

                                    </columns>

                                </TableView>

                            </children>

                        </VBox>

                        <!-- heightscores players -->
                        <VBox spacing="10.0"
                              prefWidth="280.0"
                              minWidth="230.0">

                            <children>

                                <Label text="Highscores"
                                       style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

                                <ListView fx:id="highscoresList"
                                          VBox.vgrow="ALWAYS"/>

                            </children>

                        </VBox>

                    </children>

                </HBox>

            </children>

        </VBox>

    </children>

</AnchorPane>