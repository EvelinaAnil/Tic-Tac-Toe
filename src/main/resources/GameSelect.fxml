<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<!--
  Game select screen.
  The list of game buttons is filled in by the controller from GameManager,
  so this stays generic as more games are added. Style the container/buttons
  however you like; keep fx:id="gamesBox" so the controller can populate it.
-->
<VBox alignment="CENTER" prefHeight="500.0" prefWidth="1000.0" spacing="20.0"
      stylesheets="@style.css"
      xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.tictactoe2.GameSelectController">
    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0"/>
    </padding>
    <children>
        <Label text="Choose a game"/>
        <VBox fx:id="gamesBox" alignment="CENTER" spacing="15.0"/>
        <Button maxWidth="220.0" onAction="#onBack" prefHeight="40.0" text="Back"/>
    </children>
</VBox>
